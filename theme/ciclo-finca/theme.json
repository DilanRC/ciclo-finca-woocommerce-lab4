{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "forest", "name": "Bosque", "color": "#16352c" },
        { "slug": "forest-deep", "name": "Bosque profundo", "color": "#0e261f" },
        { "slug": "pine", "name": "Pino", "color": "#285a43" },
        { "slug": "lime", "name": "Lima", "color": "#d8f05a" },
        { "slug": "route-orange", "name": "Naranja de ruta", "color": "#e65a32" },
        { "slug": "chalk", "name": "Tiza", "color": "#f4f5ef" },
        { "slug": "ink", "name": "Tinta", "color": "#18231e" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"DM Sans\", sans-serif",
          "name": "DM Sans",
          "slug": "dm-sans"
        },
        {
          "fontFamily": "\"Barlow Condensed\", sans-serif",
          "name": "Barlow Condensed",
          "slug": "barlow-condensed"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f4f5ef",
      "text": "#18231e"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--dm-sans)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barlow-condensed)",
          "fontWeight": "700"
        },
        "color": {
          "text": "#16352c"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "#16352c",
          "text": "#ffffff"
        }
      },
      "link": {
        "color": {
          "text": "#285a43"
        }
      }
    }
  }
}
